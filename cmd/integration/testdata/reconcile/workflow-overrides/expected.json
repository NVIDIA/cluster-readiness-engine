{
  "Job/test-overrides-job": {
    "kind": "Job",
    "apiVersion": "nvcre.nvidia.com/v1alpha1",
    "metadata": {
      "name": "test-overrides-job",
      "namespace": "default",
      "labels": {
        "app.kubernetes.io/managed-by": "cluster-readiness-engine",
        "nvcre.nvidia.com/group": "group-0",
        "nvcre.nvidia.com/workflow": "test-overrides"
      },
      "annotations": {
        "nvcre.nvidia.com/group-nodes": "gpu-node-01"
      },
      "ownerReferences": [
        {
          "apiVersion": "nvcre.nvidia.com/v1alpha1",
          "kind": "Workflow",
          "name": "test-overrides",
          "uid": "",
          "controller": true,
          "blockOwnerDeletion": true
        }
      ],
      "finalizers": [
        "nvcre.nvidia.com/finalizer"
      ]
    },
    "spec": {
      "workload": {
        "trainJob": {
          "runtimeRef": {
            "name": "test-runtime",
            "apiGroup": "trainer.kubeflow.org",
            "kind": "TrainingRuntime"
          },
          "trainer": {
            "image": "test-image:latest",
            "command": [
              "python",
              "train.py"
            ],
            "args": [
              "--nproc-per-node=8"
            ],
            "numNodes": 1
          },
          "runtimePatches": [
            {
              "manager": "nvcre.nvidia.com/controller",
              "trainingRuntimeSpec": {
                "template": {
                  "spec": {
                    "replicatedJobs": [
                      {
                        "name": "node",
                        "template": {
                          "spec": {
                            "template": {
                              "spec": {
                                "affinity": {
                                  "nodeAffinity": {
                                    "requiredDuringSchedulingIgnoredDuringExecution": {
                                      "nodeSelectorTerms": [
                                        {
                                          "matchExpressions": [
                                            {
                                              "key": "kubernetes.io/hostname",
                                              "operator": "In",
                                              "values": [
                                                "gpu-node-01"
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "suspend": false,
          "managedBy": "trainer.kubeflow.org/trainjob-controller"
        }
      },
      "nodeHealthMonitor": {
        "cel": {
          "expression": "node.spec.unschedulable == true"
        }
      }
    },
    "status": {
      "conditions": [
        {
          "type": "InProgress",
          "status": "True",
          "observedGeneration": 1,
          "lastTransitionTime": null,
          "reason": "WorkloadRunning",
          "message": "Workload TrainJob/test-overrides-job-workload is running"
        },
        {
          "type": "Succeeded",
          "status": "False",
          "observedGeneration": 1,
          "lastTransitionTime": null,
          "reason": "NotApplicable",
          "message": ""
        },
        {
          "type": "Failed",
          "status": "False",
          "observedGeneration": 1,
          "lastTransitionTime": null,
          "reason": "NotApplicable",
          "message": ""
        }
      ],
      "workloadRef": {
        "apiVersion": "trainer.kubeflow.org/v1alpha1",
        "kind": "TrainJob",
        "name": "test-overrides-job-workload",
        "namespace": "default"
      }
    }
  },
  "Workflow/test-overrides": {
    "kind": "Workflow",
    "apiVersion": "nvcre.nvidia.com/v1alpha1",
    "metadata": {
      "name": "test-overrides",
      "namespace": "default",
      "finalizers": [
        "nvcre.nvidia.com/workflow-finalizer"
      ]
    },
    "spec": {
      "jobTemplate": {
        "spec": {
          "workload": {
            "trainJob": {
              "runtimeRef": {
                "name": "test-runtime",
                "apiGroup": "trainer.kubeflow.org",
                "kind": "TrainingRuntime"
              },
              "trainer": {
                "image": "test-image:latest",
                "command": [
                  "python",
                  "train.py"
                ],
                "args": [
                  "--nproc-per-node=4"
                ],
                "numNodes": 1
              },
              "suspend": false,
              "managedBy": "trainer.kubeflow.org/trainjob-controller"
            }
          }
        }
      },
      "orchestration": {
        "target": {
          "nodeSelector": {
            "nvidia.com/gpu.present": "true"
          }
        },
        "execution": {},
        "iterations": 1
      },
      "overrides": [
        {
          "when": {
            "gpuArchitecture": {
              "equals": "h100"
            }
          },
          "jobTemplate": {
            "spec": {
              "workload": {
                "trainJob": {
                  "trainer": {
                    "args": [
                      "--nproc-per-node=8"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "when": {
            "platform": {
              "equals": "aws"
            }
          },
          "dependencies": [
            {
              "apiVersion": "v1",
              "data": {
                "NCCL_SOCKET_IFNAME": "eth0"
              },
              "kind": "ConfigMap",
              "metadata": {
                "name": "aws-networking-config",
                "namespace": "default"
              }
            }
          ]
        }
      ]
    },
    "status": {
      "conditions": [
        {
          "type": "InProgress",
          "status": "True",
          "observedGeneration": 1,
          "lastTransitionTime": null,
          "reason": "JobRunning",
          "message": "Iteration 1/1: 1 groups running"
        },
        {
          "type": "Succeeded",
          "status": "False",
          "observedGeneration": 1,
          "lastTransitionTime": null,
          "reason": "NotApplicable",
          "message": ""
        },
        {
          "type": "Failed",
          "status": "False",
          "observedGeneration": 1,
          "lastTransitionTime": null,
          "reason": "NotApplicable",
          "message": ""
        }
      ],
      "dependencyRefs": [
        {
          "apiVersion": "v1",
          "kind": "ConfigMap",
          "name": "aws-networking-config",
          "namespace": "default",
          "scope": "workflow"
        }
      ],
      "orchestration": {
        "totalNodes": 1,
        "nodesPerJob": 1,
        "totalGroups": 1,
        "currentIteration": 1,
        "detectedPlatform": "aws",
        "detectedGPUArchitecture": "h100",
        "appliedOverrides": [
          {
            "index": 0,
            "when": "gpuArchitecture=h100",
            "patches": "jobTemplate"
          },
          {
            "index": 1,
            "when": "platform=aws",
            "patches": "1 dependencies"
          }
        ],
        "groups": [
          {
            "name": "group-0",
            "nodes": [
              "gpu-node-01"
            ],
            "phase": "Running",
            "jobRef": {
              "apiVersion": "nvcre.nvidia.com/v1alpha1",
              "kind": "Job",
              "name": "test-overrides-job",
              "namespace": "default"
            }
          }
        ]
      }
    }
  }
}
