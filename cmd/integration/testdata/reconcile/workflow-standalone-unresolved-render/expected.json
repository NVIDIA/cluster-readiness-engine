            "platform": {
              "equals": "aws"
            }
          },
          "dependencies": [
            {
              "apiVersion": "resource.k8s.io/v1",
              "kind": "ResourceClaimTemplate",
              "metadata": {
                "labels": {
                  "app": "standalone-render"
                },
                "name": "standalone-render-roce"
              },
              "spec": {
                "spec": {
                  "devices": {
                    "requests": [
                      {
                        "exactly": {
                          "count": 8,
                          "deviceClassName": "roce.networking.k8s.aws"
                        },
                        "name": "roce"
                      }
                    ]
                  }
                }
              }
            },
            {
              "apiVersion": "trainer.kubeflow.org/v1alpha1",
              "kind": "TrainingRuntime",
              "metadata": {
                "name": "standalone-render-runtime"
              },
              "spec": {
                "template": {
                  "spec": {
                    "replicatedJobs": [
                      {
                        "name": "node",
                        "template": {
                          "spec": {
                            "template": {
                              "spec": {
                                "containers": [
                                  {
                                    "name": "node",
                                    "resources": {
                                      "claims": [
                                        {
                                          "name": "compute-domain"
                                        },
                                        {
                                          "name": "roce-channel"
                                        }
                                      ]
                                    }
                                  }
                                ],
                                "resourceClaims": [
                                  {
                                    "name": "compute-domain",
                                    "resourceClaimTemplateName": "standalone-render-channel"
                                  },
                                  {
                                    "name": "roce-channel",
                                    "resourceClaimTemplateName": "standalone-render-roce"
                                  }
                                ]
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "when": {
            "gpuArchitecture": {
              "equals": "h100"
            },
            "platform": {
              "equals": "aws"
            }
          },
          "dependencies": [
            {
              "apiVersion": "trainer.kubeflow.org/v1alpha1",
              "kind": "TrainingRuntime",
              "metadata": {
                "name": "standalone-render-runtime"
              },
              "spec": {
                "template": {
                  "spec": {
                    "replicatedJobs": [
                      {
                        "name": "node",
                        "template": {
                          "spec": {
                            "template": {
                              "spec": {
                                "containers": [
                                  {
                                    "name": "node",
                                    "resources": {
                                      "limits": {
                                        "vpc.amazonaws.com/efa": 32
                                      },
                                      "requests": {
                                        "vpc.amazonaws.com/efa": 32
                                      }
                                    }
                                  }
                                ]
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        },
        {
