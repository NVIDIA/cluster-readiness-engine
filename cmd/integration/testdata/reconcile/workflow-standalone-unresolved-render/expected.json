{
  "Workflow/standalone-render": {
    "kind": "Workflow",
    "apiVersion": "nvcre.nvidia.com/v1alpha1",
    "metadata": {
      "name": "standalone-render",
      "namespace": "default",
      "labels": {
        "app.kubernetes.io/managed-by": "nvcre",
        "nvcre.nvidia.com/workload-run": "standalone-render"
      },
      "annotations": {
        "nvcrectl.nvidia.com/detected-gpu-architecture": "h100"
      },
      "finalizers": [
        "nvcre.nvidia.com/workflow-finalizer"
      ]
    },
    "spec": {
      "jobTemplate": {
        "spec": {
          "workload": {
            "trainJob": {
              "runtimeRef": {
                "name": "standalone-render-runtime",
                "apiGroup": "trainer.kubeflow.org",
                "kind": "TrainingRuntime"
              },
              "trainer": {
                "image": "nvcr.io/nvidia/pytorch:25.08-py3",
                "command": [
                  "torchrun"
                ],
                "args": [
                  "/workspace/train.py"
                ],
                "numNodes": 2,
                "numProcPerNode": 8
              },
              "suspend": false,
              "managedBy": "trainer.kubeflow.org/trainjob-controller"
            }
          },
          "workloadMetadata": {
            "labels": {
              "kai.scheduler/queue": "queue-a"
            }
          },
          "nodeHealthMonitor": {
            "cel": {
              "expression": "node.spec.unschedulable == true"
            }
          }
        }
      },
      "orchestration": {
        "target": {
          "nodeSelector": {
            "nvidia.com/gpu.product": "NVIDIA-H100-80GB-HBM3"
          }
        },
        "execution": {
          "timeoutPerJob": "24h0m0s"
        },
        "iterations": 1
      },
      "dependencies": [
        {
          "apiVersion": "trainer.kubeflow.org/v1alpha1",
          "kind": "TrainingRuntime",
          "metadata": {
            "labels": {
              "app": "standalone-render",
              "trainer.kubeflow.org/framework": "torch"
            },
            "name": "standalone-render-runtime"
          },
          "spec": {
            "mlPolicy": {
              "numNodes": 2,
              "torch": {
                "numProcPerNode": 8
              }
            },
            "template": {
              "spec": {
                "replicatedJobs": [
                  {
                    "name": "node",
                    "template": {
                      "metadata": {
                        "labels": {
                          "app": "standalone-render",
                          "kai.scheduler/queue": "queue-a",
                          "trainer.kubeflow.org/trainjob-ancestor-step": "trainer"
                        }
                      },
                      "spec": {
                        "template": {
                          "metadata": {
                            "labels": {
                              "kai.scheduler/queue": "queue-a"
                            }
                          },
                          "spec": {
                            "containers": [
                              {
                                "env": [
                                  {
                                    "name": "NCCL_DEBUG",
                                    "value": "INFO"
                                  },
                                  {
                                    "name": "NCCL_DEBUG_SUBSYS",
                                    "value": "NET,INIT"
                                  },
                                  {
                                    "name": "NCCL_NVLS_ENABLE",
                                    "value": "1"
                                  },
                                  {
                                    "name": "NCCL_CUMEM_ENABLE",
                                    "value": "1"
                                  },
                                  {
                                    "name": "NCCL_NET_GDR_C2C",
                                    "value": "1"
                                  },
                                  {
                                    "name": "NCCL_NET_GDR_LEVEL",
                                    "value": "PHB"
                                  },
                                  {
                                    "name": "NCCL_P2P_NET_CHUNKSIZE",
                                    "value": "2097152"
                                  },
                                  {
                                    "name": "NCCL_SHM_DISABLE",
                                    "value": "1"
                                  },
                                  {
                                    "name": "NCCL_MNNVL_ENABLE",
                                    "value": "0"
                                  },
                                  {
                                    "name": "NCCL_SOCKET_IFNAME",
                                    "value": "eth0"
                                  }
                                ],
                                "image": "nvcr.io/nvidia/pytorch:25.08-py3",
                                "name": "node",
                                "resources": {
                                  "limits": {
                                    "nvidia.com/gpu": "8"
                                  },
                                  "requests": {
                                    "nvidia.com/gpu": "8"
                                  }
                                },
                                "volumeMounts": [
                                  {
                                    "mountPath": "/dev/shm",
                                    "name": "dshm"
                                  }
                                ]
                              }
                            ],
                            "schedulerName": "kai-scheduler",
                            "securityContext": {
                              "seccompProfile": {
                                "type": "RuntimeDefault"
                              }
                            },
                            "terminationGracePeriodSeconds": 30,
                            "volumes": [
                              {
                                "emptyDir": {
                                  "medium": "Memory"
                                },
                                "name": "dshm"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "overrides": [
        {
          "when": {
            "gpuArchitecture": {
              "in": [
                "gb200",
                "gb300"
              ]
            }
          },
          "dependencies": [
            {
              "apiVersion": "resource.nvidia.com/v1beta1",
              "kind": "ComputeDomain",
              "metadata": {
                "labels": {
                  "app": "standalone-render"
                },
                "name": "standalone-render-compute-domain"
              },
              "spec": {
                "channel": {
                  "allocationMode": "Single",
                  "resourceClaimTemplate": {
                    "name": "standalone-render-channel"
                  }
                },
                "numNodes": 2
              }
            },
            {
              "apiVersion": "trainer.kubeflow.org/v1alpha1",
              "kind": "TrainingRuntime",
              "metadata": {
                "name": "standalone-render-runtime"
              },
              "spec": {
                "template": {
                  "spec": {
                    "replicatedJobs": [
                      {
                        "name": "node",
                        "template": {
                          "spec": {
                            "template": {
                              "spec": {
                                "containers": [
                                  {
                                    "name": "node",
                                    "resources": {
                                      "claims": [
                                        {
                                          "name": "compute-domain"
                                        }
                                      ]
                                    }
                                  }
                                ],
                                "resourceClaims": [
                                  {
                                    "name": "compute-domain",
                                    "resourceClaimTemplateName": "standalone-render-channel"
                                  }
                                ]
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "when": {
            "gpuArchitecture": {
              "in": [
                "gb200",
                "gb300"
              ]
            },
            "platform": {
              "equals": "aws"
            }
          },
          "orchestration": {
            "topology": {
              "topologyKey": "topology.k8s.aws/network-node-layer-1"
            }
          }
        },
        {
          "when": {
            "gpuArchitecture": {
              "in": [
                "gb200",
                "gb300"
              ]
            },
            "platform": {
              "equals": "gcp"
            }
          },
          "orchestration": {
            "topology": {
              "topologyKey": "cloud.google.com/gce-topology-block"
            }
          }
        },
        {
          "when": {
            "gpuArchitecture": {
              "in": [
                "gb200",
