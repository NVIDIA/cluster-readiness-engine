  "Workflow/gcp-nc-gb-lb-communicatio-443eb": {
    "kind": "Workflow",
    "apiVersion": "nvcre.nvidia.com/v1alpha1",
    "metadata": {
      "name": "gcp-nc-gb-lb-communicatio-443eb",
      "namespace": "default",
      "labels": {
        "app.kubernetes.io/managed-by": "nvcre",
        "nvcre.nvidia.com/category-domain": "communication",
        "nvcre.nvidia.com/category-variant": "nccl-loopback",
        "nvcre.nvidia.com/certification": "gcp-nc-gb-lb"
      },
      "ownerReferences": [
        {
          "apiVersion": "nvcre.nvidia.com/v1alpha1",
          "kind": "Certification",
          "name": "gcp-nc-gb-lb",
          "uid": "",
          "controller": true,
          "blockOwnerDeletion": true
        }
      ],
      "finalizers": [
        "nvcre.nvidia.com/workflow-finalizer"
      ]
    },
    "spec": {
      "jobTemplate": {
        "spec": {
          "workload": {
            "trainJob": {
              "runtimeRef": {
                "name": "nccl-loopback-runtime",
                "apiGroup": "trainer.kubeflow.org",
                "kind": "TrainingRuntime"
              },
              "trainer": {
                "image": "nvcr.io/nvidia/pytorch:26.01-py3",
                "command": [
                  "/usr/local/bin/all_reduce_perf_mpi"
                ],
                "args": [
                  "-b",
                  "8",
                  "-e",
                  "16G",
                  "-f",
                  "2",
                  "-g",
                  "4",
                  "-n",
                  "10",
                  "-N",
                  "2"
                ],
                "env": [
                  {
                    "name": "NCCL_DEBUG",
                    "value": "INFO"
                  },
                  {
                    "name": "NCCL_SHM_DISABLE",
                    "value": "1"
                  },
                  {
                    "name": "NCCL_P2P_DISABLE",
                    "value": "1"
                  },
                  {
                    "name": "NCCL_NET_GDR_LEVEL",
                    "value": "5"
                  },
                  {
                    "name": "NCCL_MNNVL_ENABLE",
                    "value": "1"
                  }
                ],
                "numNodes": 1,
                "numProcPerNode": 1
              },
              "runtimePatches": [
                {
                  "manager": "nvcre.nvidia.com/catalog",
                  "trainingRuntimeSpec": {
                    "template": {
                      "spec": {
                        "replicatedJobs": [
                          {
                            "name": "node",
                            "template": {
                              "spec": {
                                "template": {
                                  "spec": {
                                    "volumes": [
                                      {
                                        "name": "dshm",
                                        "emptyDir": {
                                          "medium": "Memory"
                                        }
                                      }
                                    ],
                                    "containers": [
                                      {
                                        "name": "node",
                                        "volumeMounts": [
                                          {
                                            "name": "dshm",
                                            "mountPath": "/dev/shm"
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                }
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              ],
              "suspend": false,
              "managedBy": "trainer.kubeflow.org/trainjob-controller"
            }
          },
          "nodeHealthMonitor": {
            "cel": {
              "expression": "node.spec.unschedulable == true"
            }
          },
          "bandwidthMeasurement": {
            "logProfileRef": "nccl-loopback",
            "sampleInterval": "30s",
            "testType": "loopback_all_reduce"
          }
        }
      },
      "orchestration": {
        "target": {
          "nodeSelector": {
            "nvidia.com/gpu.product": "NVIDIA-GB200-NVL72"
          }
        },
        "execution": {},
        "iterations": 1
      },
      "dependencies": [
        {
          "apiVersion": "trainer.kubeflow.org/v1alpha1",
          "kind": "TrainingRuntime",
          "metadata": {
            "labels": {
              "app": "nccl-loopback"
            },
            "name": "nccl-loopback-runtime"
          },
          "spec": {
            "mlPolicy": {
              "numNodes": 1,
              "torch": {
                "numProcPerNode": 1
              }
            },
            "template": {
              "spec": {
                "replicatedJobs": [
                  {
                    "name": "node",
                    "template": {
                      "metadata": {
                        "annotations": {
                          "networking.gke.io/default-interface": "eth0",
                          "networking.gke.io/interfaces": "[\n  {\"interfaceName\":\"eth0\",\"network\":\"default\"},\n  {\"interfaceName\":\"rdma0\",\"network\":\"rdma-0\"},\n  {\"interfaceName\":\"rdma1\",\"network\":\"rdma-1\"},\n  {\"interfaceName\":\"rdma2\",\"network\":\"rdma-2\"},\n  {\"interfaceName\":\"rdma3\",\"network\":\"rdma-3\"}\n]\n"
                        },
                        "labels": {
                          "trainer.kubeflow.org/trainjob-ancestor-step": "trainer"
                        }
                      },
                      "spec": {
                        "template": {
                          "spec": {
                            "containers": [
                              {
                                "env": [
                                  {
                                    "name": "NCCL_MNNVL_ENABLE",
                                    "value": "1"
                                  }
                                ],
                                "image": "nvcr.io/nvidia/pytorch:26.01-py3",
                                "name": "node",
                                "resources": {
                                  "claims": [
                                    {
                                      "name": "compute-domain-channel"
                                    }
                                  ],
                                  "limits": {
                                    "networking.gke.io.networks/rdma-0": "1",
                                    "networking.gke.io.networks/rdma-1": "1",
                                    "networking.gke.io.networks/rdma-2": "1",
                                    "networking.gke.io.networks/rdma-3": "1",
                                    "nvidia.com/gpu": "4"
                                  },
                                  "requests": {
                                    "networking.gke.io.networks/rdma-0": "1",
                                    "networking.gke.io.networks/rdma-1": "1",
                                    "networking.gke.io.networks/rdma-2": "1",
                                    "networking.gke.io.networks/rdma-3": "1",
                                    "nvidia.com/gpu": "4"
                                  }
                                },
                                "securityContext": {
                                  "capabilities": {
                                    "add": [
                                      "IPC_LOCK"
                                    ]
                                  }
                                }
                              }
                            ],
                            "resourceClaims": [
                              {
                                "name": "compute-domain-channel",
                                "resourceClaimTemplateName": "nccl-loopback-channel"
                              }
                            ],
                            "restartPolicy": "OnFailure",
                            "tolerations": [
                              {
                                "operator": "Exists"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "apiVersion": "resource.nvidia.com/v1beta1",
          "kind": "ComputeDomain",
          "metadata": {
            "labels": {
              "app": "nccl-loopback"
            },
            "name": "nccl-loopback-compute-domain"
          },
          "spec": {
            "channel": {
              "allocationMode": "Single",
              "resourceClaimTemplate": {
                "name": "nccl-loopback-channel"
              }
            },
            "numNodes": 1
          }
        }
      ]
    },
    "status": {
      "conditions": [
        {
          "type": "InProgress",
          "status": "True",
          "observedGeneration": 1,
          "lastTransitionTime": null,
          "reason": "JobRunning",
          "message": "Iteration 1/1: 1 groups running"
        },
        {
          "type": "Succeeded",
          "status": "False",
          "observedGeneration": 1,
          "lastTransitionTime": null,
          "reason": "NotApplicable",
          "message": ""
        },
        {
          "type": "Failed",
          "status": "False",
          "observedGeneration": 1,
          "lastTransitionTime": null,
          "reason": "NotApplicable",
          "message": ""
        }
      ],
      "dependencyRefs": [
        {
          "apiVersion": "trainer.kubeflow.org/v1alpha1",
          "kind": "TrainingRuntime",
          "name": "nccl-loopback-runtime-443eb-job",
          "namespace": "default",
          "scope": "job",
          "groupName": "group-0",
          "iteration": 1
        },
        {
          "apiVersion": "resource.nvidia.com/v1beta1",
          "kind": "ComputeDomain",
          "name": "nccl-loopback-compute-domain-443eb-job",
          "namespace": "default",
          "scope": "job",
          "groupName": "group-0",
          "iteration": 1
        }
      ],
      "orchestration": {
        "totalNodes": 1,
        "nodesPerJob": 1,
        "totalGroups": 1,
        "currentIteration": 1,
        "detectedPlatform": "gcp",
        "detectedGPUArchitecture": "gb200",
        "gpuProducts": [
          "NVIDIA-GB200-NVL72"
        ],
        "groups": [
          {
            "name": "group-0",
            "nodes": [
              "gcp-gb200-lb-node-01"
            ],
            "phase": "Running",
            "jobRef": {
              "apiVersion": "nvcre.nvidia.com/v1alpha1",
              "kind": "Job",
              "name": "gcp-nc-gb-lb-communicatio-443eb-job",
              "namespace": "default"
            }
          }
        ]
      }
    }
  }
}
