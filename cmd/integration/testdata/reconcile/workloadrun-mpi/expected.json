              }
            },
            {
              "apiVersion": "trainer.kubeflow.org/v1alpha1",
              "kind": "TrainingRuntime",
              "metadata": {
                "name": "test-mpi-run-runtime"
              },
              "spec": {
                "template": {
                  "spec": {
                    "replicatedJobs": [
                      {
