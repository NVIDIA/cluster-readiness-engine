{
  "WorkloadRun/deleted-workflow-run": {
    "kind": "WorkloadRun",
    "apiVersion": "nvcre.nvidia.com/v1alpha1",
    "metadata": {
      "name": "deleted-workflow-run",
      "namespace": "default"
    },
    "spec": {
      "target": {
        "nodeSelector": {
          "deleted-workflow": "true"
        }
      },
      "image": "test-image:latest",
      "framework": {
        "exec": {
          "command": [
            "echo",
            "success"
          ]
        }
      },
      "numNodes": 1
    },
    "status": {
      "conditions": [
        {
          "type": "InProgress",
          "status": "False",
          "lastTransitionTime": null,
          "reason": "Superseded",
          "message": ""
        },
        {
          "type": "Succeeded",
          "status": "False",
          "lastTransitionTime": null,
          "reason": "Superseded",
          "message": ""
        },
        {
          "type": "Failed",
          "status": "True",
          "lastTransitionTime": null,
          "reason": "WorkflowDeleted",
          "message": "Workflow was deleted"
        }
      ],
      "workflowRef": {
        "name": "deleted-workflow-run",
        "namespace": "default"
      }
    }
  },
  "events": [
    {
      "type": "Warning",
      "reason": "WorkflowDeleted",
      "message": "Workflow was deleted",
      "involvedObject": {
        "kind": "WorkloadRun",
        "name": "deleted-workflow-run"
      },
      "count": 1
    }
  ]
}
