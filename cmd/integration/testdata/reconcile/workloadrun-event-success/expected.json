{
  "WorkloadRun/event-success-run": {
    "kind": "WorkloadRun",
    "apiVersion": "nvcre.nvidia.com/v1alpha1",
    "metadata": {
      "name": "event-success-run",
      "namespace": "default"
    },
    "spec": {
      "target": {
        "nodeSelector": {
          "event-success": "true"
        }
      },
      "image": "test-image:latest",
      "framework": {
        "exec": {
          "command": [
            "echo",
            "success"
          ]
        }
      },
      "numNodes": 1
    },
    "status": {
      "conditions": [
        {
          "type": "InProgress",
          "status": "False",
          "lastTransitionTime": null,
          "reason": "Superseded",
          "message": ""
        },
        {
          "type": "Succeeded",
          "status": "True",
          "lastTransitionTime": null,
          "reason": "WorkflowSucceeded",
          "message": "Workflow completed successfully"
        },
        {
          "type": "Failed",
          "status": "False",
          "lastTransitionTime": null,
          "reason": "Superseded",
          "message": ""
        }
      ],
      "workflowRef": {
        "name": "event-success-run",
        "namespace": "default"
      },
      "detectedPlatform": "aws",
      "detectedGPUArchitecture": "h100",
      "succeededNodesRef": {
        "apiGroup": null,
        "kind": "ConfigMap",
        "name": "succeeded-nodes"
      }
    }
  },
  "events": [
    {
      "type": "Normal",
      "reason": "WorkflowCreated",
      "message": "Workflow event-success-run created",
      "involvedObject": {
        "kind": "WorkloadRun",
        "name": "event-success-run"
      },
      "count": 1
    },
    {
      "type": "Normal",
      "reason": "WorkflowSucceeded",
      "message": "Workflow completed successfully",
      "involvedObject": {
        "kind": "WorkloadRun",
        "name": "event-success-run"
      },
      "count": 1
    }
  ]
}
