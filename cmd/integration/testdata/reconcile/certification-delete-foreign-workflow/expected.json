{
  "Workflow/foreign-wf-keep": {
    "kind": "Workflow",
    "apiVersion": "nvcre.nvidia.com/v1alpha1",
    "metadata": {
      "name": "foreign-wf-keep",
      "namespace": "default",
      "finalizers": [
        "nvcre.nvidia.com/workflow-finalizer"
      ]
    },
    "spec": {
      "jobTemplate": {
        "spec": {
          "workload": {
            "trainJob": {
              "runtimeRef": {
                "name": "user-runtime",
                "apiGroup": "trainer.kubeflow.org",
                "kind": "TrainingRuntime"
              },
              "trainer": {
                "image": "user-image:latest",
                "command": [
                  "python",
                  "user_train.py"
                ],
                "numNodes": 1
              },
              "suspend": false,
              "managedBy": "trainer.kubeflow.org/trainjob-controller"
            }
          }
        }
      },
      "orchestration": {
        "target": {
          "nodeSelector": {
            "example.com/user-pool": "true"
          }
        },
        "execution": {},
        "iterations": 1
      }
    },
    "status": {
      "conditions": [
        {
          "type": "InProgress",
          "status": "False",
          "lastTransitionTime": null,
          "reason": "NotApplicable",
          "message": ""
        },
        {
          "type": "Succeeded",
          "status": "False",
          "lastTransitionTime": null,
          "reason": "NotApplicable",
          "message": ""
        },
        {
          "type": "Failed",
          "status": "True",
          "lastTransitionTime": null,
          "reason": "JobFailed",
          "message": "User job failed"
        }
      ]
    }
  }
}
