  "TrainingRuntime/nccl-alltoall-runtime-c29f7-job": {
    "apiVersion": "trainer.kubeflow.org/v1alpha1",
    "kind": "TrainingRuntime",
    "metadata": {
      "annotations": {
        "nvcre.nvidia.com/workflow-uid": "workflow-uid"
      },
      "labels": {
        "app": "nccl-alltoall",
        "nvcre.nvidia.com/workflow": "aws-rtx-a2a-communication-c29f7",
        "trainer.kubeflow.org/framework": "mpi"
      },
      "name": "nccl-alltoall-runtime-c29f7-job",
      "namespace": "default",
      "ownerReferences": [
        {
          "apiVersion": "nvcre.nvidia.com/v1alpha1",
          "kind": "Job",
          "name": "aws-rtx-a2a-communication-c29f7-job",
          "uid": ""
        }
      ]
    },
    "spec": {
      "mlPolicy": {
        "mpi": {
          "mpiImplementation": "OpenMPI",
          "numProcPerNode": 8,
          "runLauncherAsNode": false,
          "sshAuthMountPath": "/tmp/mpi-ssh-raw"
        },
        "numNodes": 1
      },
      "template": {
        "spec": {
          "network": {
            "publishNotReadyAddresses": true
          },
          "replicatedJobs": [
            {
              "groupName": "default",
              "name": "node",
              "replicas": 1,
              "template": {
                "spec": {
                  "template": {
                    "spec": {
                      "containers": [
                        {
                          "args": [
                            "set -x \u0026\u0026\nif ! test -x /usr/sbin/sshd; then\n  if ! command -v apt-get \u003e/dev/null 2\u003e\u00261 || ! command -v timeout \u003e/dev/null 2\u003e\u00261; then\n    echo \"sshd is not installed and the image has no apt-get or timeout to install it; use an image that ships /usr/sbin/sshd\" \u003e\u00262\n    exit 1\n  fi\n  apt=\"-o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Dpkg::Use-Pty=0\"\n  for attempt in 1 2 3; do\n    [ \"$attempt\" -eq 1 ] || timeout -s KILL 120 dpkg --configure -a\n    timeout -s KILL 120 apt-get $apt update \u0026\u0026\n      timeout -s KILL 120 apt-get $apt install -y --no-install-recommends openssh-server \u0026\u0026 break\n    echo \"sshd install attempt $attempt of 3 failed or timed out\" \u003e\u00262\n    [ \"$attempt\" -lt 3 ] || exit 1\n  done\nfi \u0026\u0026\nmkdir -p /var/run/sshd  \u0026\u0026\nchmod 0755 /var/run/sshd  \u0026\u0026\nmkdir -p /root/.ssh \u0026\u0026\nchmod 700 /root/.ssh \u0026\u0026\ncp /tmp/mpi-ssh-raw/* /root/.ssh/ \u0026\u0026\nchmod 600 /root/.ssh/id_rsa \u0026\u0026\nchmod 644 /root/.ssh/id_rsa.pub /root/.ssh/authorized_keys \u0026\u0026\n/usr/sbin/sshd -De"
                          ],
                          "command": [
                            "sh",
                            "-c"
                          ],
                          "image": "nvcr.io/nvidia/pytorch:26.03-py3@sha256:3c90e38f5ec51e51d1c73bd7eb3d83674a254f451147c5cadc4344314258a112",
                          "name": "node",
                          "readinessProbe": {
                            "exec": {
                              "command": [
                                "sh",
                                "-c",
                                "command -v ssh \u003e/dev/null 2\u003e\u00261 || exec grep -q ':0016 [0-9A-F]*:[0-9A-F]* 0A ' /proc/net/tcp /proc/net/tcp6\nset -- ssh -n -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 127.0.0.1 true\ncommand -v timeout \u003e/dev/null 2\u003e\u00261 \u0026\u0026 set -- timeout 8 \"$@\"\nexec \"$@\""
                              ]
                            },
                            "initialDelaySeconds": 5,
                            "periodSeconds": 30,
                            "timeoutSeconds": 10
                          },
                          "resources": {
                            "limits": {
                              "nvidia.com/gpu": "8",
                              "vpc.amazonaws.com/efa": "4"
                            },
                            "requests": {
                              "nvidia.com/gpu": "8",
                              "vpc.amazonaws.com/efa": "4"
                            }
                          },
                          "securityContext": {
                            "capabilities": {
                              "add": [
                                "IPC_LOCK",
                                "SYS_CHROOT"
                              ]
                            }
                          },
                          "volumeMounts": [
                            {
                              "mountPath": "/tmp/mpi-ssh-raw",
                              "name": "mpi-ssh-auth",
                              "readOnly": true
                            }
                          ]
                        }
                      ],
                      "restartPolicy": "OnFailure"
                    }
                  }
                }
              }
            },
            {
              "dependsOn": [
                {
                  "name": "node",
                  "status": "Ready"
                }
              ],
              "groupName": "default",
              "name": "launcher",
              "replicas": 1,
              "template": {
                "metadata": {
                  "labels": {
                    "trainer.kubeflow.org/trainjob-ancestor-step": "trainer"
                  }
                },
                "spec": {
                  "backoffLimit": 1,
                  "podFailurePolicy": {
                    "rules": [
                      {
                        "action": "Ignore",
                        "onPodConditions": [
                          {
                            "status": "True",
                            "type": "DisruptionTarget"
                          }
                        ]
                      }
                    ]
                  },
                  "template": {
                    "spec": {
                      "containers": [
                        {
                          "image": "nvcr.io/nvidia/pytorch:26.03-py3@sha256:3c90e38f5ec51e51d1c73bd7eb3d83674a254f451147c5cadc4344314258a112",
                          "name": "node",
                          "resources": {
                            "limits": {
                              "cpu": "2",
                              "memory": "1Gi"
                            }
                          },
                          "volumeMounts": [
                            {
                              "mountPath": "/tmp/mpi-ssh-raw",
                              "name": "mpi-ssh-auth",
                              "readOnly": true
                            },
                            {
                              "mountPath": "/root/.ssh",
                              "name": "ssh-keys"
                            }
                          ]
                        }
                      ],
                      "initContainers": [
                        {
                          "args": [
                            "set -x \u0026\u0026\ncp /tmp/mpi-ssh-raw/* /root/.ssh/ \u0026\u0026\nchmod 600 /root/.ssh/id_rsa \u0026\u0026\nchmod 644 /root/.ssh/id_rsa.pub /root/.ssh/authorized_keys"
                          ],
                          "command": [
                            "sh",
                            "-c"
                          ],
                          "image": "nvcr.io/nvidia/pytorch:26.03-py3@sha256:3c90e38f5ec51e51d1c73bd7eb3d83674a254f451147c5cadc4344314258a112",
                          "name": "fix-ssh-permissions",
                          "volumeMounts": [
                            {
                              "mountPath": "/tmp/mpi-ssh-raw",
                              "name": "mpi-ssh-auth",
                              "readOnly": true
                            },
                            {
                              "mountPath": "/root/.ssh",
                              "name": "ssh-keys"
                            }
                          ]
                        }
                      ],
                      "restartPolicy": "Never",
                      "volumes": [
                        {
                          "emptyDir": {},
                          "name": "ssh-keys"
                        }
                      ]
                    }
                  }
                }
              }
            }
          ],
          "successPolicy": {
            "operator": "All",
            "targetReplicatedJobs": [
              "launcher"
            ]
          }
        }
      }
    }
  }
