{
  "Job/wf-job-collide-job": {
    "kind": "Job",
    "apiVersion": "nvcre.nvidia.com/v1alpha1",
    "metadata": {
      "name": "wf-job-collide-job",
      "namespace": "default",
      "finalizers": [
        "nvcre.nvidia.com/finalizer"
      ]
    },
    "spec": {
      "workload": {
        "trainJob": {
          "runtimeRef": {
            "name": "user-runtime",
            "apiGroup": "trainer.kubeflow.org",
            "kind": "TrainingRuntime"
          },
          "trainer": {
            "image": "user-image:latest",
            "command": [
              "python",
              "user_train.py"
            ],
            "numNodes": 1
          },
          "suspend": false,
          "managedBy": "trainer.kubeflow.org/trainjob-controller"
        }
      }
    },
    "status": {
      "conditions": [
        {
          "type": "InProgress",
          "status": "False",
          "lastTransitionTime": null,
          "reason": "NotApplicable",
          "message": ""
        },
        {
          "type": "Succeeded",
          "status": "True",
          "lastTransitionTime": null,
          "reason": "WorkloadCompleted",
          "message": "User workload completed"
        },
        {
          "type": "Failed",
          "status": "False",
          "lastTransitionTime": null,
          "reason": "NotApplicable",
          "message": ""
        }
      ]
    }
  }
}
