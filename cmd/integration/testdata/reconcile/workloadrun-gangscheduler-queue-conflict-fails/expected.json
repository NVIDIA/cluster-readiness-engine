{
  "WorkloadRun/wr-queue-conflict": {
    "kind": "WorkloadRun",
    "apiVersion": "nvcre.nvidia.com/v1alpha1",
    "metadata": {
      "name": "wr-queue-conflict",
      "namespace": "default"
    },
    "spec": {
      "target": {
        "nodeSelector": {
          "nvidia.com/gpu.product": "NVIDIA-H100-80GB-HBM3"
        }
      },
      "image": "nvcr.io/nvidia/pytorch:25.08-py3",
      "framework": {
        "torch": {
          "script": "/workspace/train.py"
        }
      },
      "numNodes": 1,
      "gangScheduler": {
        "schedulerName": "kai-scheduler",
        "queue": "team-a"
      },
      "workloadMetadata": {
        "labels": {
          "kai.scheduler/queue": "team-b"
        }
      }
    },
    "status": {
      "conditions": [
        {
          "type": "InProgress",
          "status": "False",
          "lastTransitionTime": null,
          "reason": "Superseded",
          "message": ""
        },
        {
          "type": "Succeeded",
          "status": "False",
          "lastTransitionTime": null,
          "reason": "Superseded",
          "message": ""
        },
        {
          "type": "Failed",
          "status": "True",
          "lastTransitionTime": null,
          "reason": "BuildFailed",
          "message": "workloadrun wr-queue-conflict: spec.jobTemplate.spec.workloadMetadata.labels[\"kai.scheduler/queue\"]: conflicting label value \"team-b\", expected \"team-a\""
        }
      ]
    }
  },
  "expectAbsent": {
    "Workflow/wr-queue-conflict": "notCreated"
  }
}
