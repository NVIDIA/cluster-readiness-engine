      "namespace": "default",
      "finalizers": [
        "nvcre.nvidia.com/finalizer"
      ]
    },
    "spec": {
      "workload": {
        "trainJob": {
          "runtimeRef": {
            "name": "test-runtime",
            "apiGroup": "trainer.kubeflow.org",
            "kind": "TrainingRuntime"
          },
          "trainer": {
            "image": "test-image:latest",
            "command": [
              "python",
              "train.py"
            ],
            "numNodes": 1
          },
          "suspend": false,
          "managedBy": "trainer.kubeflow.org/trainjob-controller"
        }
      },
      "nodeHealthMonitor": {
        "cel": {
          "expression": "node.metadata.labels[\"nvidia.com/gpu.unhealthy\"] == \"true\""
        }
      }
    },
    "status": {
