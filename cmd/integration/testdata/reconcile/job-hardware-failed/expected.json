        }
      ],
      "failedNodes": [
        {
          "name": "test-hw-node",
          "reason": "HardwareFailureDetected",
          "message": "Hardware failure detected by node health check"
        }
      ],
      "workloadRef": {
        "apiVersion": "trainer.kubeflow.org/v1alpha1",
