          "reason": "NotApplicable",
          "message": ""
        },
        {
          "type": "Failed",
          "status": "False",
          "observedGeneration": 1,
          "lastTransitionTime": null,
          "reason": "NotApplicable",
          "message": ""
        },
        {
          "type": "HardwareFailed",
          "status": "True",
          "observedGeneration": 1,
          "lastTransitionTime": null,
          "reason": "HardwareFailureDetected",
