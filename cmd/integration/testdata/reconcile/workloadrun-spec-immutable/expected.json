{
  "WorkloadRun/immutable-run": {
    "kind": "WorkloadRun",
    "apiVersion": "nvcre.nvidia.com/v1alpha1",
    "metadata": {
      "name": "immutable-run",
      "namespace": "default"
    },
    "spec": {
      "target": {
        "nodeSelector": {
          "nvidia.com/gpu.product": "NVIDIA-H100-80GB-HBM3"
        }
      },
      "image": "nvcr.io/nvidia/pytorch:25.08-py3",
      "framework": {
        "torch": {
          "script": "/config/train.sh"
        }
      },
      "numNodes": 2,
      "config": {
        "inline": {
          "train.sh": "#!/bin/bash\necho \"training\""
        }
      },
      "env": [
        {
          "name": "CUDA_DEVICE_MAX_CONNECTIONS",
          "value": "1"
        }
      ]
    },
    "status": {
      "conditions": [
        {
          "type": "InProgress",
          "status": "True",
          "lastTransitionTime": null,
          "reason": "WorkflowCreated",
          "message": "Workflow immutable-run created"
        },
        {
          "type": "Succeeded",
          "status": "False",
          "lastTransitionTime": null,
          "reason": "Superseded",
          "message": ""
        },
        {
          "type": "Failed",
          "status": "False",
          "lastTransitionTime": null,
          "reason": "Superseded",
          "message": ""
        }
      ],
      "workflowRef": {
        "name": "immutable-run",
        "namespace": "default"
      },
      "detectedPlatform": "aws",
      "detectedGPUArchitecture": "h100"
    }
  },
  "specImmutability": {
    "WorkloadRun/default/immutable-run/spec.env": {
      "message": "spec is immutable after creation",
      "rejected": true
    },
    "WorkloadRun/default/immutable-run/spec.image": {
      "message": "spec is immutable after creation",
      "rejected": true
    },
    "WorkloadRun/default/immutable-run/spec.numNodes": {
      "message": "spec is immutable after creation",
      "rejected": true
    }
  }
}
