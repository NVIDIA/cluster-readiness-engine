          "observedGeneration": 1,
          "lastTransitionTime": null,
          "reason": "NotApplicable",
          "message": ""
        }
      ],
      "dependencyRefs": [
        {
          "apiVersion": "trainer.kubeflow.org/v1alpha1",
          "kind": "TrainingRuntime",
          "name": "nccl-all-reduce-runtime-aad69-job",
          "namespace": "default",
          "scope": "job",
          "groupName": "group-0",
          "iteration": 1
        }
      ],
      "orchestration": {
        "totalNodes": 2,
        "nodesPerJob": 2,
        "totalGroups": 1,
        "currentIteration": 1,
        "detectedPlatform": "oci",
        "detectedGPUArchitecture": "l40s",
        "groups": [
          {
            "name": "group-0",
            "nodes": [
              "oci-l40s-node-01",
              "oci-l40s-node-02"
            ],
            "phase": "Running",
            "jobRef": {
              "apiVersion": "cre.nvidia.com/v1alpha1",
              "kind": "Job",
              "name": "oci-l40s-communication-nc-aad69-job",
              "namespace": "default"
            }
          }
        ]
      }
    }
  }
