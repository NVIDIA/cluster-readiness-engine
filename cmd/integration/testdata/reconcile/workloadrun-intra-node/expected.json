{
  "Workflow/test-intra-node-run": {
    "kind": "Workflow",
    "apiVersion": "nvcre.nvidia.com/v1alpha1",
    "metadata": {
      "name": "test-intra-node-run",
      "namespace": "default",
      "labels": {
        "app.kubernetes.io/managed-by": "nvcre",
        "nvcre.nvidia.com/workload-run": "test-intra-node-run"
      },
      "ownerReferences": [
        {
          "apiVersion": "nvcre.nvidia.com/v1alpha1",
          "kind": "WorkloadRun",
          "name": "test-intra-node-run",
          "uid": "",
          "controller": true,
          "blockOwnerDeletion": true
        }
      ],
      "finalizers": [
        "nvcre.nvidia.com/workflow-finalizer"
      ]
    },
    "spec": {
      "jobTemplate": {
        "spec": {
          "workload": {
            "trainJob": {
              "runtimeRef": {
                "name": "test-intra-node-run-runtime",
                "apiGroup": "trainer.kubeflow.org",
                "kind": "TrainingRuntime"
              },
              "trainer": {
                "image": "nvcr.io/nvidia/pytorch:25.08-py3",
                "command": [
                  "/bin/bash",
                  "-c"
                ],
                "args": [
                  "rm -rf /opt/amazon\nunset NCCL_NET_PLUGIN\nunset NCCL_TUNER_PLUGIN\nunset AWS_OFI_NCCL_VERSION\nexec \"torchrun\" \"/workspace/train.py\""
                ],
                "numNodes": 1,
                "numProcPerNode": 8
              },
              "suspend": false,
              "managedBy": "trainer.kubeflow.org/trainjob-controller"
            }
          },
          "nodeHealthMonitor": {
            "cel": {
              "expression": "node.spec.unschedulable == true"
            }
          }
        }
      },
      "orchestration": {
        "target": {
          "nodeSelector": {
            "nvidia.com/gpu.product": "NVIDIA-H100-80GB-HBM3"
          }
        },
        "execution": {
          "timeoutPerJob": "24h0m0s"
        },
        "iterations": 1
      },
      "dependencies": [
        {
          "apiVersion": "trainer.kubeflow.org/v1alpha1",
          "kind": "TrainingRuntime",
          "metadata": {
            "labels": {
              "app": "test-intra-node-run",
              "trainer.kubeflow.org/framework": "torch"
            },
            "name": "test-intra-node-run-runtime"
          },
          "spec": {
            "mlPolicy": {
              "numNodes": 1,
              "torch": {
                "numProcPerNode": 8
              }
            },
            "template": {
              "spec": {
                "replicatedJobs": [
                  {
                    "name": "node",
                    "template": {
                      "metadata": {
                        "labels": {
                          "app": "test-intra-node-run",
                          "trainer.kubeflow.org/trainjob-ancestor-step": "trainer"
                        }
                      },
                      "spec": {
                        "template": {
                          "spec": {
                            "containers": [
                              {
                                "env": [
                                  {
                                    "name": "NCCL_DEBUG",
                                    "value": "INFO"
                                  },
                                  {
                                    "name": "NCCL_DEBUG_SUBSYS",
                                    "value": "NET,INIT"
                                  },
                                  {
                                    "name": "NCCL_NVLS_ENABLE",
                                    "value": "1"
                                  },
                                  {
                                    "name": "NCCL_CUMEM_ENABLE",
                                    "value": "1"
                                  },
                                  {
                                    "name": "NCCL_NET_GDR_C2C",
                                    "value": "1"
                                  },
                                  {
                                    "name": "NCCL_NET_GDR_LEVEL",
                                    "value": "PHB"
                                  },
                                  {
                                    "name": "NCCL_P2P_NET_CHUNKSIZE",
                                    "value": "2097152"
                                  },
                                  {
                                    "name": "NCCL_SHM_DISABLE",
                                    "value": "1"
                                  },
                                  {
                                    "name": "NCCL_MNNVL_ENABLE",
                                    "value": "0"
                                  },
                                  {
                                    "name": "NCCL_SOCKET_IFNAME",
                                    "value": "eth0"
                                  }
                                ],
                                "image": "nvcr.io/nvidia/pytorch:25.08-py3",
                                "name": "node",
                                "resources": {
                                  "limits": {
                                    "nvidia.com/gpu": "8"
                                  },
                                  "requests": {
                                    "nvidia.com/gpu": "8"
                                  }
                                },
                                "volumeMounts": [
                                  {
                                    "mountPath": "/dev/shm",
                                    "name": "dshm"
                                  }
                                ]
                              }
                            ],
                            "securityContext": {
                              "seccompProfile": {
                                "type": "RuntimeDefault"
                              }
                            },
                            "terminationGracePeriodSeconds": 30,
                            "volumes": [
                              {
                                "emptyDir": {
                                  "medium": "Memory"
                                },
                                "name": "dshm"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "overrides": [
        {
          "when": {
            "gpuArchitecture": {
              "in": [
                "gb200",
                "gb300"
              ]
            }
          },
          "dependencies": [
            {
              "apiVersion": "resource.nvidia.com/v1beta1",
              "kind": "ComputeDomain",
              "metadata": {
                "labels": {
                  "app": "test-intra-node-run"
                },
                "name": "test-intra-node-run-compute-domain"
              },
              "spec": {
                "channel": {
                  "allocationMode": "Single",
                  "resourceClaimTemplate": {
                    "name": "test-intra-node-run-channel"
                  }
                },
                "numNodes": 1
              }
            },
            {
              "apiVersion": "trainer.kubeflow.org/v1alpha1",
              "kind": "TrainingRuntime",
              "metadata": {
                "name": "test-intra-node-run-runtime"
              },
              "spec": {
                "template": {
                  "spec": {
                    "replicatedJobs": [
                      {
                        "name": "node",
                        "template": {
                          "spec": {
                            "template": {
                              "spec": {
                                "containers": [
                                  {
                                    "name": "node",
                                    "resources": {
                                      "claims": [
                                        {
                                          "name": "compute-domain"
                                        }
                                      ]
                                    }
                                  }
                                ],
                                "resourceClaims": [
                                  {
                                    "name": "compute-domain",
                                    "resourceClaimTemplateName": "test-intra-node-run-channel"
                                  }
                                ]
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "when": {
            "gpuArchitecture": {
              "in": [
