{
  "WorkloadRun/wr-torch-reserved-init-container": {
    "kind": "WorkloadRun",
    "apiVersion": "nvcre.nvidia.com/v1alpha1",
    "metadata": {
      "name": "wr-torch-reserved-init-container",
      "namespace": "default"
    },
    "spec": {
      "target": {
        "nodeSelector": {
          "nvidia.com/gpu.product": "NVIDIA-H100-80GB-HBM3"
        }
      },
      "image": "nvcr.io/nvidia/pytorch:26.01-py3",
      "framework": {
        "torch": {
          "script": "/config/train.sh"
        }
      },
      "numNodes": 1,
      "config": {
        "inline": {
          "train.sh": "#!/bin/bash\necho \"training\"\n"
        }
      },
      "initContainers": [
        {
          "name": "node",
          "image": "busybox:1.36",
          "command": [
            "sh",
            "-c",
            "echo staging"
          ],
          "resources": {}
        }
      ]
    },
    "status": {
      "conditions": [
        {
          "type": "InProgress",
          "status": "False",
          "lastTransitionTime": null,
          "reason": "Superseded",
          "message": ""
        },
        {
          "type": "Succeeded",
          "status": "False",
          "lastTransitionTime": null,
          "reason": "Superseded",
          "message": ""
        },
        {
          "type": "Failed",
          "status": "True",
          "lastTransitionTime": null,
          "reason": "BuildFailed",
          "message": "workloadrun wr-torch-reserved-init-container: spec.initContainers[0].name: \"node\" is reserved: the workload container has that name and a pod's container names must be unique; rename the init container"
        }
      ]
    }
  },
  "expectAbsent": {
    "Workflow/wr-torch-reserved-init-container": "notCreated"
  }
}
