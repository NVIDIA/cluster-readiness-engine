          "message": "Workload TrainJob/test-bw-pending-workload completed: All workers completed"
        },
        {
          "type": "Failed",
          "status": "False",
          "observedGeneration": 1,
          "lastTransitionTime": null,
          "reason": "NotApplicable",
          "message": ""
        }
      ],
      "workloadRef": {
        "apiVersion": "trainer.kubeflow.org/v1alpha1",
        "kind": "TrainJob",
        "name": "test-bw-pending-workload",
        "namespace": "default"
      }
    }
  }
}
