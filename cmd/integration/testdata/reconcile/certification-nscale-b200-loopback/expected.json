      "ownerReferences": [
        {
          "apiVersion": "nvcre.nvidia.com/v1alpha1",
          "kind": "Certification",
          "name": "nscale-b2-lb",
          "uid": "",
          "controller": true,
          "blockOwnerDeletion": true
        }
      ],
      "finalizers": [
        "nvcre.nvidia.com/workflow-finalizer"
      ]
    },
    "spec": {
      "jobTemplate": {
        "spec": {
          "workload": {
            "trainJob": {
              "runtimeRef": {
                "name": "nccl-loopback-runtime",
                "apiGroup": "trainer.kubeflow.org",
                "kind": "TrainingRuntime"
              },
              "trainer": {
                "image": "nvcr.io/nvidia/pytorch:26.01-py3",
                "command": [
                  "/usr/local/bin/all_reduce_perf_mpi"
                ],
                "args": [
                  "-b",
                  "8",
                  "-e",
                  "16G",
                  "-f",
                  "2",
                  "-g",
                  "8",
                  "-n",
                  "10",
                  "-N",
                  "2"
                ],
                "env": [
                  {
                    "name": "NCCL_SOCKET_IFNAME",
                    "value": "eth0"
                  },
                  {
                    "name": "NCCL_DEBUG",
                    "value": "INFO"
                  },
                  {
                    "name": "NCCL_NVLS_ENABLE",
                    "value": "1"
                  },
                  {
                    "name": "NCCL_CUMEM_ENABLE",
                    "value": "1"
                  },
                  {
                    "name": "NCCL_P2P_NET_CHUNKSIZE",
                    "value": "2097152"
                  },
                  {
                    "name": "NCCL_MNNVL_ENABLE",
                    "value": "0"
                  },
                  {
                    "name": "NCCL_IB_PCI_RELAXED_ORDERING",
                    "value": "1"
                  },
                  {
                    "name": "SHARP_COLL_ENABLE_PCI_RELAXED_ORDERING",
                    "value": "1"
                  },
                  {
                    "name": "OMPI_MCA_btl_openib_warn_default_gid_prefix",
                    "value": "0"
                  },
                  {
                    "name": "PMIX_MCA_gds",
                    "value": "^ds12"
                  },
                  {
                    "name": "NCCL_SHM_DISABLE",
                    "value": "1"
                  },
                  {
                    "name": "NCCL_P2P_DISABLE",
                    "value": "1"
                  }
                ],
                "numNodes": 1,
                "numProcPerNode": 1
              },
              "runtimePatches": [
                {
                  "manager": "nvcre.nvidia.com/catalog",
                  "trainingRuntimeSpec": {
                    "template": {
                      "spec": {
                        "replicatedJobs": [
                          {
                            "name": "node",
                            "template": {
                              "spec": {
                                "template": {
                                  "spec": {
                                    "volumes": [
                                      {
                                        "name": "dshm",
                                        "emptyDir": {
                                          "medium": "Memory"
                                        }
                                      }
                                    ],
                                    "containers": [
                                      {
                                        "name": "node",
                                        "volumeMounts": [
                                          {
                                            "name": "dshm",
                                            "mountPath": "/dev/shm"
                                          }
                                        ]
                                      }
                                    ]
                                  }
                                }
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              ],
              "suspend": false,
              "managedBy": "trainer.kubeflow.org/trainjob-controller"
            }
          },
          "nodeHealthMonitor": {
            "cel": {
              "expression": "node.spec.unschedulable == true"
            }
          },
          "bandwidthMeasurement": {
            "logProfileRef": "nccl-loopback",
            "sampleInterval": "30s",
            "testType": "loopback_all_reduce"
          }
        }
      },
      "orchestration": {
        "target": {
          "nodeSelector": {
            "nvidia.com/gpu.present": "true"
          }
        },
        "execution": {},
        "iterations": 1
      },
      "dependencies": [
