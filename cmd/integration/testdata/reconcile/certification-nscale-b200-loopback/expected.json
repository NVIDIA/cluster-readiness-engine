          "metadata": {
            "labels": {
              "app": "nccl-loopback"
            },
            "name": "nccl-loopback-runtime"
          },
          "spec": {
            "mlPolicy": {
              "numNodes": 1,
              "torch": {
                "numProcPerNode": 1
              }
            },
            "template": {
              "spec": {
                "replicatedJobs": [
                  {
                    "name": "node",
                    "template": {
                      "metadata": {
                        "labels": {
                          "trainer.kubeflow.org/trainjob-ancestor-step": "trainer"
                        }
                      },
                      "spec": {
                        "template": {
                          "spec": {
                            "containers": [
                              {
                                "image": "nvcr.io/nvidia/pytorch:26.01-py3",
                                "name": "node",
                                "resources": {
                                  "claims": [
                                    {
                                      "name": "gpu"
                                    },
                                    {
                                      "name": "rdma"
                                    }
                                  ],
                                  "limits": {},
                                  "requests": {}
                                },
                                "securityContext": {
                                  "capabilities": {
                                    "add": [
                                      "IPC_LOCK"
                                    ]
                                  }
                                }
                              }
                            ],
                            "resourceClaims": [
                              {
                                "name": "gpu",
                                "resourceClaimTemplateName": "nccl-loopback-gpu"
                              },
                              {
                                "name": "rdma",
                                "resourceClaimTemplateName": "nccl-loopback-rdma"
                              }
                            ],
                            "restartPolicy": "OnFailure",
                            "tolerations": [
                              {
                                "operator": "Exists"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "apiVersion": "resource.k8s.io/v1",
          "kind": "ResourceClaimTemplate",
          "metadata": {
            "labels": {
              "app": "nccl-loopback"
            },
            "name": "nccl-loopback-gpu"
          },
          "spec": {
            "spec": {
              "devices": {
                "requests": [
                  {
                    "exactly": {
                      "count": 8,
                      "deviceClassName": "gpu.nvidia.com"
                    },
                    "name": "gpu"
                  }
                ]
              }
            }
          }
        },
        {
          "apiVersion": "resource.k8s.io/v1",
          "kind": "ResourceClaimTemplate",
          "metadata": {
            "labels": {
              "app": "nccl-loopback"
            },
            "name": "nccl-loopback-rdma"
          },
          "spec": {
            "spec": {
              "devices": {
                "requests": [
                  {
                    "exactly": {
                      "count": 8,
                      "deviceClassName": "rdma.nscale.com"
                    },
                    "name": "rdma"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "status": {
