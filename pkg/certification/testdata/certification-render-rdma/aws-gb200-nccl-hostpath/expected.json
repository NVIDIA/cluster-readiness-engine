          }
        ],
        "volumes": [
          "rdma-devices=hostPath:/dev/infiniband:Directory"
        ]
      },
      {
        "dependency": "nccl-all-reduce-runtime",
        "replicatedJob": "launcher",
        "containers": [
          {
            "name": "node",
            "privileged": null,
            "capabilities": [],
