    "trainerEnv": [],
    "replicatedJobs": [
      {
        "dependency": "nccl-all-reduce-runtime",
        "replicatedJob": "node",
        "containers": [
          {
            "name": "node",
            "privileged": true,
            "capabilities": [
              "IPC_LOCK"
            ],
            "resources": [
              "limits/hugepages-2Mi=10256Mi",
              "limits/memory=800Gi",
              "limits/nvidia.com/gpu=4",
              "limits/vpc.amazonaws.com/efa=4",
              "requests/hugepages-2Mi=10256Mi",
              "requests/memory=800Gi",
              "requests/nvidia.com/gpu=4",
              "requests/vpc.amazonaws.com/efa=4"
