      "plm_rsh_agent",
      "ssh",
      "-x",
      "LD_LIBRARY_PATH=/opt/amazon/openmpi/lib:/opt/nccl/build/lib:/opt/amazon/efa/lib:/opt/aws-ofi-nccl/install/lib:/usr/local/nvidia/lib:/opt/amazon/ofi-nccl/lib/aarch64-linux-gnu",
      "-x",
      "PATH=$PATH:/opt/amazon/efa/bin:/usr/bin",
      "-x",
      "NCCL_DEBUG=INFO",
      "-x",
      "FI_PROVIDER=efa",
      "-x",
      "FI_EFA_USE_DEVICE_RDMA=1",
      "-x",
      "FI_EFA_FORK_SAFE=1",
      "-x",
      "NCCL_MNNVL_ENABLE=1",
      "/opt/nccl-tests/build/all_reduce_perf",
      "-b",
      "8",
      "-e",
      "16G",
      "-f",
      "2",
      "-n",
      "100",
      "-N",
      "10"
