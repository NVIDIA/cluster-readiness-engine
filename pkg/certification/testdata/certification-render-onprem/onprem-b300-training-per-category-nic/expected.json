[
  {
    "workflow": "onprem-b300-train-trainin-b8f33",
    "targetNodeSelector": {
      "nvidia.com/gpu.product": "NVIDIA-B300-SXM6-AC"
    },
    "dependencyKinds": [
      "TrainingRuntime",
      "ConfigMap"
    ],
    "trainerArgs": [
      "/config/train.sh"
    ],
    "trainerEnv": [],
