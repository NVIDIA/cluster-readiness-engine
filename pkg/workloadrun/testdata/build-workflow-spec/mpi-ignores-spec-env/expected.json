{
  "trainer": {
    "image": "nvcr.io/nvidia/pytorch:24.01-py3",
    "command": [
      "timeout",
      "3600",
      "/usr/local/mpi/bin/mpirun"
    ],
    "args": [
      "-N",
      "8",
      "--allow-run-as-root",
      "--mca",
      "plm_rsh_args",
      "-o StrictHostKeyChecking=no -o ConnectionAttempts=10",
      "-x",
      "NCCL_DEBUG=INFO",
      "-x",
      "NCCL_MNNVL_ENABLE=0",
      "/workspace/all_reduce_perf"
    ],
    "numNodes": 2,
    "numProcPerNode": 8
  },
  "timeoutPerJob": "24h0m0s",
  "iterations": 1,
  "dependencyKinds": [
    "TrainingRuntime"
  ],
  "validation": null,
  "workerEnv": null,
  "workerVolumeMounts": [
    "mpi-ssh-auth at /tmp/mpi-ssh-raw",
    "dshm at /dev/shm"
  ],
  "runtimeVolumes": [
    "dshm"
  ],
  "overrideCount": 14
}
