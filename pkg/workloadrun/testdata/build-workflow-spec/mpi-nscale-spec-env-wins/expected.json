{
  "trainer": {
    "image": "nvcr.io/nvidia/pytorch:26.01-py3",
    "command": [
      "timeout",
      "3600",
      "/usr/local/mpi/bin/mpirun"
    ],
    "args": [
      "-N",
      "8",
      "--allow-run-as-root",
      "--mca",
      "plm_rsh_args",
      "-o StrictHostKeyChecking=no -o ConnectionAttempts=10",
      "-x",
      "NCCL_NET_GDR_C2C=1",
      "-x",
      "NCCL_NET_GDR_LEVEL=PHB",
      "-x",
      "NCCL_SHM_DISABLE=0",
      "-x",
      "NCCL_SOCKET_IFNAME=eth0",
      "-x",
      "NCCL_DEBUG=INFO",
      "-x",
      "NCCL_NVLS_ENABLE=1",
      "-x",
      "NCCL_CUMEM_ENABLE=1",
      "-x",
      "NCCL_P2P_NET_CHUNKSIZE=2097152",
      "-x",
      "NCCL_MNNVL_ENABLE=0",
      "-x",
      "NCCL_IB_PCI_RELAXED_ORDERING=0",
      "-x",
      "SHARP_COLL_ENABLE_PCI_RELAXED_ORDERING=1",
      "-x",
      "OMPI_MCA_btl_openib_warn_default_gid_prefix=0",
      "-x",
      "PMIX_MCA_gds=^ds12",
      "/usr/local/bin/all_reduce_perf_mpi"
    ],
    "numNodes": 2,
    "numProcPerNode": 8
  },
  "timeoutPerJob": "24h0m0s",
  "iterations": 1,
  "dependencyKinds": [
    "TrainingRuntime"
  ],
  "validation": null,
  "workerEnv": [
    "NCCL_DEBUG=INFO",
    "NCCL_NVLS_ENABLE=1",
    "NCCL_CUMEM_ENABLE=1",
    "NCCL_NET_GDR_C2C=1",
    "NCCL_NET_GDR_LEVEL=PHB",
    "NCCL_P2P_NET_CHUNKSIZE=2097152",
    "NCCL_MNNVL_ENABLE=0",
    "NCCL_SOCKET_IFNAME=eth0",
    "NCCL_IB_PCI_RELAXED_ORDERING=0",
    "NCCL_SHM_DISABLE=0"
  ],
  "launcherEnv": [
    "NCCL_DEBUG=INFO",
    "NCCL_NVLS_ENABLE=1",
    "NCCL_CUMEM_ENABLE=1",
    "NCCL_NET_GDR_C2C=1",
    "NCCL_NET_GDR_LEVEL=PHB",
    "NCCL_P2P_NET_CHUNKSIZE=2097152",
    "NCCL_MNNVL_ENABLE=0",
    "NCCL_SOCKET_IFNAME=eth0",
    "NCCL_IB_PCI_RELAXED_ORDERING=0",
    "NCCL_SHM_DISABLE=0"
  ],
  "workerVolumeMounts": [
    "mpi-ssh-auth at /tmp/mpi-ssh-raw",
    "dshm at /dev/shm"
  ],
  "runtimeVolumes": [
    "dshm"
  ],
  "overrideCount": 21
}
