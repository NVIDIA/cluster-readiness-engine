[
  {
    "when": {
      "gpuArchitecture": {
        "equals": "gb300"
      },
      "platform": {
        "equals": "aws"
      }
    },
    "mpiArgs": [
      "-x",
      "NCCL_NET_PLUGIN=none"
    ]
  },
  {
    "when": {
      "gpuArchitecture": {
        "equals": "gb300"
      },
      "platform": {
        "equals": "aws"
      }
    },
    "mpiArgs": [
      "--mca",
      "orte_keep_fqdn_hostnames",
      "true",
      "--mca",
      "pml",
      "ob1",
      "--mca",
      "btl",
      "tcp,self",
      "--mca",
      "btl_tcp_if_include",
      "eth0",
      "--mca",
      "oob",
      "tcp",
      "--mca",
      "oob_tcp_if_include",
      "eth0",
      "--mca",
      "coll_ucc_enable",
      "0",
      "--mca",
      "coll_hcoll_enable",
      "0",
      "-x",
      "NCCL_DEBUG_SUBSYS=NET,INIT",
      "-x",
      "NCCL_SOCKET_IFNAME=eth0",
      "-x",
      "NCCL_IB_GID_INDEX=3",
      "-x",
      "NCCL_NVLS_ENABLE=1",
      "-x",
      "NCCL_CUMEM_ENABLE=1",
      "-x",
      "NCCL_NET_GDR_C2C=1"
    ]
  },
  {
    "when": {
      "gpuArchitecture": {
        "equals": "gb200"
      },
      "platform": {
        "equals": "aws"
      }
    },
    "mpiArgs": [
      "-x",
      "FI_PROVIDER=efa",
      "-x",
      "FI_EFA_USE_DEVICE_RDMA=1",
      "-x",
      "FI_EFA_FORK_SAFE=1"
    ]
  },
  {
    "when": {
      "gpuArchitecture": {
        "equals": "h100"
      },
      "platform": {
        "equals": "aws"
      }
    },
    "mpiArgs": [
      "-x",
      "FI_PROVIDER=efa",
      "-x",
      "FI_EFA_USE_DEVICE_RDMA=1",
      "-x",
      "FI_EFA_FORK_SAFE=1"
    ]
  },
  {
    "when": {
      "gpuArchitecture": {
        "equals": "rtxpro6000"
      },
      "platform": {
        "equals": "gcp"
      }
    },
    "mpiArgs": [
      "-x",
      "NCCL_DEBUG=INFO",
      "-x",
      "NCCL_IB_DISABLE=1",
      "-x",
      "NCCL_NET_PLUGIN=none",
      "-x",
      "NCCL_SOCKET_IFNAME=eth0",
      "-x",
      "NCCL_P2P_LEVEL=PHB"
    ]
  },
  {
    "when": {
      "gpuArchitecture": {
        "in": [
          "b200",
          "gb300"
        ]
      },
      "platform": {
        "equals": "nscale"
      }
    },
    "mpiArgs": [
      "-x",
      "NCCL_SOCKET_IFNAME=eth0",
      "-x",
      "NCCL_DEBUG=INFO",
      "-x",
      "NCCL_NVLS_ENABLE=1",
      "-x",
      "NCCL_CUMEM_ENABLE=1",
      "-x",
      "NCCL_P2P_NET_CHUNKSIZE=2097152",
      "-x",
      "NCCL_MNNVL_ENABLE=1",
      "-x",
      "NCCL_IB_PCI_RELAXED_ORDERING=1",
      "-x",
      "SHARP_COLL_ENABLE_PCI_RELAXED_ORDERING=1",
      "-x",
      "OMPI_MCA_btl_openib_warn_default_gid_prefix=0",
      "-x",
      "PMIX_MCA_gds=^ds12"
    ]
  }
