      "template nvcre-values-probe <workspace>/probe --set manager.image.repository=registry.example.com/mirror/manager --set manager.imagePullSecrets[0].name=mirror-pull-secret",
      "show crds oci://ghcr.io/nvidia/cluster-readiness-engine --version v0.8.0",
      "upgrade --install nvcre oci://ghcr.io/nvidia/cluster-readiness-engine --namespace nvcre --create-namespace --version v0.8.0 --wait --timeout 5m0s -f <workspace>/values.json --kubeconfig <kubeconfig>"
    ],
    "upgradeValues": {
      "manager": {
        "image": {
          "repository": "registry.example.com/mirror/manager"
        },
        "imagePullSecrets": [
          {
            "name": "mirror-pull-secret"
          }
        ]
      }
    },
