{
  "kind": "Workflow",
  "apiVersion": "nvcre.nvidia.com/v1alpha1",
  "metadata": {
    "name": "test-workflow",
    "annotations": {
      "nvcrectl.nvidia.com/applied-overrides": "[{\"index\":0,\"when\":\"gpuArchitecture=rtxpro6000, platform=aws\",\"patches\":\"jobTemplate\"}]",
      "nvcrectl.nvidia.com/detected-gpu-architecture": "rtxpro6000",
      "nvcrectl.nvidia.com/detected-platform": "aws"
    }
  },
  "spec": {
    "jobTemplate": {
      "spec": {
        "workload": {
          "trainJob": {
            "trainer": {
              "image": "nvcr.io/nvidia/pytorch:26.03-py3",
              "command": [
                "/bin/bash",
                "-c"
              ],
              "args": [
                "torchrun --nnodes 2"
              ],
              "env": [
                {
                  "name": "CRE_TEST_AWS_RTX_MARKER",
                  "value": "matched"
                }
              ],
              "numNodes": 2,
              "numProcPerNode": 8
            }
          }
        }
      }
    },
    "orchestration": {
      "execution": {}
    }
  }
}
