{
  "kind": "Workflow",
  "apiVersion": "nvcre.nvidia.com/v1alpha1",
  "metadata": {
    "name": "test-workflow",
    "annotations": {
      "nvcrectl.nvidia.com/applied-overrides": "[{\"index\":0,\"when\":\"gpuArchitecture=gb300\",\"patches\":\"1 dependencies\"}]",
      "nvcrectl.nvidia.com/detected-gpu-architecture": "gb300",
      "nvcrectl.nvidia.com/detected-platform": "aws"
    }
  },
  "spec": {
    "jobTemplate": {
      "spec": {
        "workload": {
          "trainJob": {
            "trainer": {
              "image": "nvcr.io/nvidia/pytorch:24.12-py3",
              "command": [
                "/bin/bash",
                "-c"
              ],
              "args": [
                "torchrun --nnodes 2"
              ],
              "numNodes": 2,
              "numProcPerNode": 4
            }
          }
        }
      }
    },
    "orchestration": {
      "execution": {}
    },
    "dependencies": [
      {
        "apiVersion": "v1",
        "data": {
          "arch": "gb300"
        },
        "kind": "ConfigMap",
        "metadata": {
          "name": "gb300-config"
        }
      }
    ]
  }
}
