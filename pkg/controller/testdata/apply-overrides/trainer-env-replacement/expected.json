{
  "jobTemplate": {
    "spec": {
      "workload": {
        "trainJob": {
          "runtimeRef": {
            "name": "test-runtime"
          },
          "trainer": {
            "image": "test-image:latest",
            "env": [
              {
                "name": "BATCH_SIZE",
                "value": "64"
              }
            ],
            "numNodes": 1
          }
        }
      }
    }
  },
  "orchestration": {
    "execution": {},
    "iterations": 1
  },
  "overrides": [
    {
      "when": {
        "gpuArchitecture": {
          "equals": "h100"
        }
      },
      "jobTemplate": {
        "spec": {
          "workload": {
            "trainJob": {
              "trainer": {
                "env": [
                  {
                    "name": "BATCH_SIZE",
                    "value": "64"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
