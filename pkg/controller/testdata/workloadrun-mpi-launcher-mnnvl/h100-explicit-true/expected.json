{
  "launcherCommand": [
    "timeout",
    "3600",
    "/usr/local/mpi/bin/mpirun"
  ],
  "launcherArgs": [
    "-N",
    "8",
    "--allow-run-as-root",
    "--mca",
    "plm_rsh_args",
    "-o StrictHostKeyChecking=no -o ConnectionAttempts=10",
    "-x",
    "NCCL_DEBUG=INFO",
    "-x",
    "NCCL_NVLS_ENABLE=1",
    "-x",
    "NCCL_CUMEM_ENABLE=1",
    "-x",
    "NCCL_NET_GDR_C2C=1",
    "-x",
    "NCCL_NET_GDR_LEVEL=PHB",
    "-x",
    "NCCL_P2P_NET_CHUNKSIZE=2097152",
    "-x",
    "NCCL_SHM_DISABLE=1",
    "-x",
    "NCCL_MNNVL_ENABLE=1",
    "-x",
    "NCCL_SOCKET_IFNAME=eth0",
    "/usr/local/bin/all_reduce_perf_mpi",
    "-b",
    "8",
    "-e",
    "32G"
  ],
  "envMNNVL": [
    "1"
  ]
}
