{
  "managerEnv": [
    {
      "name": "POD_NAMESPACE",
      "fieldPath": "metadata.namespace"
    },
    {
      "name": "SERVICE_ACCOUNT_NAME",
      "fieldPath": "spec.serviceAccountName"
    }
  ],
  "runRoleBindings": [
    {
      "kind": "ClusterRoleBinding",
      "name": "nvcre-run-rolebinding",
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "ClusterRole",
        "name": "nvcre-run-role"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "render-test-nvcre-manager",
          "namespace": "default"
        }
      ]
    }
  ]
}
