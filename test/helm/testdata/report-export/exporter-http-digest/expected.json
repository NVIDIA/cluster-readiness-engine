{
  "resources": [
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "report-test",
        "namespace": "custom-reports"
      }
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRole",
      "metadata": {
        "name": "custom-reports-report-test"
      },
      "rules": [
        {
          "apiGroups": [
            "nvcre.nvidia.com"
          ],
          "resources": [
            "certifications",
            "workflows",
            "jobs",
            "goodputmeasurements",
            "bandwidthmeasurements"
          ],
          "verbs": [
            "get",
            "list"
          ]
        },
        {
          "apiGroups": [
            "batch"
          ],
          "resources": [
            "jobs"
          ],
          "verbs": [
            "get"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "configmaps"
          ],
          "verbs": [
            "get"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRoleBinding",
      "metadata": {
        "name": "custom-reports-report-test"
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "ClusterRole",
        "name": "custom-reports-report-test"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "report-test",
          "namespace": "custom-reports"
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "Role",
      "metadata": {
        "name": "report-test",
        "namespace": "custom-reports"
      },
      "rules": [
        {
          "apiGroups": [
            "nvcre.nvidia.com"
          ],
          "resources": [
            "reportexports"
          ],
          "verbs": [
            "get",
            "list",
            "watch",
            "update",
            "patch",
            "delete"
          ]
        },
        {
          "apiGroups": [
            "nvcre.nvidia.com"
          ],
          "resources": [
            "reportexports/status",
            "reportexports/finalizers"
          ],
          "verbs": [
            "get",
            "update",
            "patch"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "configmaps"
          ],
          "verbs": [
            "get",
            "list",
            "watch",
            "create",
            "update",
            "patch",
            "delete"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "secrets"
          ],
          "verbs": [
            "get"
          ]
        },
        {
          "apiGroups": [
            "coordination.k8s.io"
          ],
          "resources": [
            "leases"
          ],
          "verbs": [
            "get",
            "list",
            "watch",
            "create",
            "update",
            "patch"
          ]
        },
        {
          "apiGroups": [
            "",
            "events.k8s.io"
          ],
          "resources": [
            "events"
          ],
          "verbs": [
            "create",
            "patch"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
        "name": "report-test",
        "namespace": "custom-reports"
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "Role",
        "name": "report-test"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "report-test",
          "namespace": "custom-reports"
        }
      ]
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "report-test",
        "namespace": "custom-reports"
      },
      "spec": {
        "replicas": 2,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/instance": "report-test",
            "app.kubernetes.io/name": "nvcre-report-exporter"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/component": "report-exporter",
              "app.kubernetes.io/instance": "report-test",
              "app.kubernetes.io/managed-by": "Helm",
              "app.kubernetes.io/name": "nvcre-report-exporter",
              "app.kubernetes.io/version": "dev"
            }
          },
          "spec": {
            "containers": [
              {
                "args": [
                  "--namespace=custom-reports",
                  "--health-probe-bind-address=:8081",
                  "--metrics-bind-address=:8080",
                  "--leader-elect",
                  "--allow-http"
                ],
                "command": [
                  "/report-exporter"
                ],
                "image": "registry.example.com/nvcre@sha256:735ad1e142a378b0919510bd1fc113cd53ab754bc79b7f0980d647d50a914523",
                "imagePullPolicy": "IfNotPresent",
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "health"
                  },
                  "initialDelaySeconds": 15,
                  "periodSeconds": 20
                },
                "name": "report-exporter",
                "ports": [
                  {
                    "containerPort": 8081,
                    "name": "health"
                  },
                  {
                    "containerPort": 8080,
                    "name": "metrics"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/readyz",
                    "port": "health"
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10
                },
                "resources": {
                  "limits": {
                    "cpu": "500m",
                    "memory": "512Mi"
                  },
                  "requests": {
                    "cpu": "10m",
                    "memory": "256Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                }
              }
            ],
            "imagePullSecrets": [
              {
                "name": "registry-credentials"
              }
            ],
            "securityContext": {
              "runAsNonRoot": true,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "serviceAccountName": "report-test",
            "terminationGracePeriodSeconds": 30
          }
        }
      }
    }
  ]
}
